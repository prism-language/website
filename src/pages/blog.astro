---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Blog">
    <Navbar />

    <main class="container page">

        <h1>Blog</h1>

        <p>
            Development updates, release announcements, and design articles
            about Prism will be published here.
        </p>

        <p>
            There are no posts yet.
        </p>

    </main>

    <Footer />
</Layout>

<style>
.page {
    max-width: 800px;
    padding: 5rem 0;
}

.page p {
    margin-top: 1.5rem;
    line-height: 1.8;
}
</style>
